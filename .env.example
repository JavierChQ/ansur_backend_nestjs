DB_SSL=false
JWT_SECRET=mi_clave_de_seguridad

CLOUDINARY_CLOUD_NAME=nombre_de_tu_cuenta_cloudinary
CLOUDINARY_API_KEY=key_de_api_cloudinary
CLOUDINARY_API_SECRET=clave_de_seguridad_cloudinary

# Correo (Resend)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Ansur <ventas@ansur.com.pe>"
COMPANY_NAME=Ansur
COMPANY_LEGAL_NAME=Ansur Perú S.A.C.
COMPANY_RUT=20600674651
COMPANY_ADDRESS=Cal. Garci Carbajal nro 101, int. a-12
COMPANY_WEBSITE=https://ansur.com.pe
COMPANY_WHATSAPP=51947346467
IGV_RATE=0.18

FRONTEND_URL=http://localhost:4200
ADMIN_FRONTEND_URL=http://localhost:4201
PASSWORD_SETUP_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=1
AUTH_THROTTLE_LIMIT=3
AUTH_THROTTLE_TTL_MS=60000

# Habilitar en local si pruebas detrás de proxy (Railway/Nginx lo usa en producción)
# TRUST_PROXY=true

# Mercado Pago (https://www.mercadopago.com.pe/developers/panel/app)
# IMPORTANTE: copiar Public Key y Access Token JUNTOS desde la misma pestaña:
#   - Desarrollo → "Credenciales de prueba" (ambas con prefijo TEST-)
#   - Producción → "Credenciales de producción" (ambas con prefijo APP_USR-)
# Si mezclás claves de distintas apps o entornos, el pago falla con "internal_error".
# Verificá el par completo con: npm run verify:mercadopago
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx
# Webhooks → URL prod: https://api.ansur.com.pe/mercadopago/webhooks
# Evento: payment | Secret del panel → MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_WEBHOOK_SECRET=whsec_xxxxxxxx

# Consulta DNI/RUC (ApisPeru - https://apisperu.com)
IDENTITY_API_BASE_URL=https://dniruc.apisperu.com/api/v1
IDENTITY_API_TOKEN=
IDENTITY_API_TIMEOUT_MS=8000
IDENTITY_CACHE_TTL_SECONDS=86400
IDENTITY_THROTTLE_LIMIT=30
IDENTITY_THROTTLE_TTL_MS=60000

# --- Variables de producción (Railway / servidor) ---
NODE_ENV=production
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=whsec_xxxxxxxx