# Correo (Resend)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Ansur <ventas@ansur.com.pe>"
COMPANY_NAME=Ansur
COMPANY_RUT=20123456789
COMPANY_ADDRESS=Cal. Garci Carbajal nro 101, int. a-12
IGV_RATE=0.18

# Mercado Pago (https://www.mercadopago.com.pe/developers/panel/app)
# IMPORTANTE: copiar Public Key y Access Token JUNTOS desde la misma pestaña:
#   - Desarrollo → "Credenciales de prueba" (ambas con prefijo TEST-)
#   - Producción → "Credenciales de producción" (ambas con prefijo APP_USR-)
# Si mezclás claves de distintas apps o entornos, el pago falla con "Invalid credentials".
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx
# Webhooks → URL prod: https://api.ansur.com.pe/mercadopago/webhooks
# Evento: payment | Secret del panel → MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Variables de producción (Railway / servidor) ---
# NODE_ENV=production
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
# MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx
