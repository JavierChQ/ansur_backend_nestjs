# =============================================================================
# Ansur Backend — variables de entorno
# Copiar a .env y ajustar valores antes de arrancar la aplicación.
# =============================================================================


# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# TRUST_PROXY=true


# -----------------------------------------------------------------------------
# Base de datos (MySQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_ansur
DB_USER=javier
DB_PASSWORD=mi_clave_de_seguridad


# -----------------------------------------------------------------------------
# Autenticación y seguridad
# -----------------------------------------------------------------------------
JWT_SECRET=mi_clave_de_seguridad
HASH_SALT=10

# Límite de intentos en login y registro
AUTH_THROTTLE_LIMIT=3
AUTH_THROTTLE_TTL_MS=60000

# Vigencia de tokens enviados por correo (horas)
PASSWORD_SETUP_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=1


# -----------------------------------------------------------------------------
# Seed inicial (npm run seed)
# Crea el primer super administrador si el email no existe.
# En producción: descomentar SEED_ALLOW_PRODUCTION=true solo en el primer deploy.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@ansur.com.pe
SUPER_ADMIN_PASSWORD=CambiarEnPrimerDeploy!
SUPER_ADMIN_NAME=Super
SUPER_ADMIN_LASTNAME=Admin
SUPER_ADMIN_PHONE=51999999999
# SEED_ALLOW_PRODUCTION=true


# -----------------------------------------------------------------------------
# Cloudinary (imágenes de productos, categorías y avatares)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=nombre_de_tu_cuenta_cloudinary
CLOUDINARY_API_KEY=key_de_api_cloudinary
CLOUDINARY_API_SECRET=clave_de_seguridad_cloudinary


# -----------------------------------------------------------------------------
# Correo y datos de la empresa (Resend)
# Usado en activación de cuenta, reset de contraseña y recibos de pedido.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Ansur <ventas@ansur.com.pe>"

FRONTEND_URL=http://localhost:4200
ADMIN_FRONTEND_URL=http://localhost:4201

COMPANY_NAME=Ansur
COMPANY_LEGAL_NAME=Ansur Perú S.A.C.
COMPANY_RUT=20600674651
COMPANY_ADDRESS=Cal. Garci Carbajal nro 101, int. a-12
COMPANY_WEBSITE=https://www.ansur.com.pe
COMPANY_WHATSAPP=51947346467
COMPANY_FACEBOOK_URL=https://www.facebook.com/p/Ansel-peru-100063315543096/
COMPANY_TIKTOK_URL=https://www.tiktok.com/@anselperu
WHATSAPP_CHECKOUT_TTL_HOURS=2
IGV_RATE=0.18


# -----------------------------------------------------------------------------
# Mercado Pago
# https://www.mercadopago.com.pe/developers/panel/app
#
# Copiar Public Key y Access Token JUNTOS desde la misma pestaña:
#   Desarrollo  → prefijo TEST-
#   Producción  → prefijo APP_USR-
#
# Webhook prod: https://api.ansur.com.pe/mercadopago/webhooks (evento: payment)
# Verificar par de credenciales: npm run verify:mercadopago
# -----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=whsec_xxxxxxxx


# -----------------------------------------------------------------------------
# Consulta DNI/RUC (ApisPeru)
# https://apisperu.com
# -----------------------------------------------------------------------------
IDENTITY_API_BASE_URL=https://dniruc.apisperu.com/api/v1
IDENTITY_API_TOKEN=
IDENTITY_API_TIMEOUT_MS=8000
IDENTITY_CACHE_TTL_SECONDS=86400
IDENTITY_THROTTLE_LIMIT=30
IDENTITY_THROTTLE_TTL_MS=60000
